# Copy to .env for local dev (`netlify dev`). In production these live in
# Netlify → Site configuration → Environment variables. Never commit real values.

# --- Google service account (one account, access granted to both products) ---
# From the JSON key file: "client_email"
GOOGLE_CLIENT_EMAIL=adsitco-report@your-project.iam.gserviceaccount.com
# From the JSON key file: "private_key". Keep the literal \n escapes on one line,
# or paste the real multi-line key — both are handled.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# --- Which properties to read ---
# GA4 numeric property ID (Admin → Property Settings), digits only, not "G-XXXX".
GA4_PROPERTY_ID=123456789
# Search Console property, exactly as it appears in the GSC property picker.
# Domain property:  sc-domain:adsitco.com
# URL prefix:       https://www.adsitco.com/
GSC_SITE_URL=sc-domain:adsitco.com

# --- Access control ---
# Shared password for viewing the report. Leave unset to make the report public
# (not recommended — it exposes your analytics).
REPORT_PASSWORD=change-me

# Separate secret that authorises a forced data refresh:
#   /api/report?force=1  with header  x-refresh-token: <value>
REFRESH_TOKEN=another-long-random-string

# --- Optional tuning ---
# Days of history pulled on each refresh (default 90, max 365).
HISTORY_DAYS=90
# Label shown in the report header.
SITE_LABEL=adsitco.com
